<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ForgeQuest</AssemblyName>
    <RootNamespace>ForgeQuestDesktop</RootNamespace>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <!-- Bump this before every shared/exported build (see SESSION_NOTES.md "Versioning shared builds").
         Drives the exe's own file-properties version AND the exported filename. -->
    <Version>0.1.18</Version>
    <FileVersion>0.1.18.0</FileVersion>
    <AssemblyVersion>0.1.18.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <!-- Always pull the live canonical file at build/publish time — no manual
         sync step to forget, unlike the Android assets copy. -->
    <None Include="..\..\www\index.html" Link="www\index.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Music tracks — too big to inline as data URIs like the rest of the
         game's assets, so they ship as real files the local server routes to
         by path (see MainForm.cs's ServeLoop). -->
    <None Include="..\..\www\audio\**\*.*">
      <Link>www\audio\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Sword sprites — one PNG per sword (85 total), shown in the new-sword
         discovery popup. Same real-file treatment as the music tracks above,
         not inlined as base64 (see MainForm.cs's ServeLoop / ContentTypes). -->
    <None Include="..\..\www\swords\**\*.*">
      <Link>www\swords\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Nameplate-free variants of the same 85 sprites, one-to-one by filename
         (SWORD_SPRITE_NOTITLE derives each path from SWORD_SPRITE at runtime,
         not a second hand-typed map) — used for the small crafting-in-progress
         preview, where a small icon reads better without a big text banner. -->
    <None Include="..\..\www\swords_notitle\**\*.*">
      <Link>www\swords_notitle\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Ingot icons — one per material, used on the ore-palette chips and the
         crafting grid (placed/cooking/ready cells). Same real-file treatment;
         at ~120KB each these are well past what's reasonable to inline like
         the tiny HAMMER_ICON/NAV_ICONS data URIs. -->
    <None Include="..\..\www\ingots\**\*.*">
      <Link>www\ingots\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Background art — the body/workshop-panel/mine-map JPEGs and the 5
         crafting-table tier backdrops (CRAFT_TABLE_BG), plus the Expeditions
         nav button's art (NAV_BG_IMAGES) — moved out of index.html's base64
         (was ~3MB of it) for the same reasoning as every other real-file
         asset above, and because a single-file update on Steam would
         otherwise invalidate this whole blob on every patch. -->
    <None Include="..\..\www\backgrounds\**\*.*">
      <Link>www\backgrounds\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>